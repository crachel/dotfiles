// Only settings that differ from Zellij's defaults. `zellij setup --dump-config` shows the rest.
// Zellij rewrites this file (with all the defaults) if you save settings from its configuration screen.

// tmux-style keys. Zellij starts locked (default_mode below), so every key goes to the shell;
// Ctrl-b is the only prefix and each command drops back to locked, like tmux.
keybinds clear-defaults=true {
    locked {
        bind "Ctrl b" { SwitchToMode "tmux"; }
    }
    tmux {
        bind "Ctrl b" { Write 2; SwitchToMode "locked"; }
        bind "Esc" "Ctrl c" { SwitchToMode "locked"; }

        // panes
        bind "\"" { NewPane "down"; SwitchToMode "locked"; }
        bind "%" { NewPane "right"; SwitchToMode "locked"; }
        bind "x" { CloseFocus; SwitchToMode "locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "o" { FocusNextPane; SwitchToMode "locked"; }
        bind "Left" "h" { MoveFocus "left"; SwitchToMode "locked"; }
        bind "Down" "j" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Up" "k" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Right" "l" { MoveFocus "right"; SwitchToMode "locked"; }
        bind "{" { MovePaneBackwards; SwitchToMode "locked"; }
        bind "}" { MovePane; SwitchToMode "locked"; }
        bind "!" { BreakPane; SwitchToMode "locked"; }
        bind "space" { NextSwapLayout; SwitchToMode "locked"; }
        // resize stays in prefix mode so it repeats; Esc to finish
        bind "Ctrl Left" { Resize "Increase left"; }
        bind "Ctrl Down" { Resize "Increase down"; }
        bind "Ctrl Up" { Resize "Increase up"; }
        bind "Ctrl Right" { Resize "Increase right"; }

        // windows (zellij tabs)
        bind "c" { NewTab; SwitchToMode "locked"; }
        bind "," { SwitchToMode "renametab"; TabNameInput 0; }
        bind "&" { CloseTab; SwitchToMode "locked"; }
        bind "n" { GoToNextTab; SwitchToMode "locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "0" { GoToTab 1; SwitchToMode "locked"; }
        bind "1" { GoToTab 2; SwitchToMode "locked"; }
        bind "2" { GoToTab 3; SwitchToMode "locked"; }
        bind "3" { GoToTab 4; SwitchToMode "locked"; }
        bind "4" { GoToTab 5; SwitchToMode "locked"; }
        bind "5" { GoToTab 6; SwitchToMode "locked"; }
        bind "6" { GoToTab 7; SwitchToMode "locked"; }
        bind "7" { GoToTab 8; SwitchToMode "locked"; }
        bind "8" { GoToTab 9; SwitchToMode "locked"; }
        bind "9" { GoToTab 10; SwitchToMode "locked"; }

        // sessions
        bind "d" { Detach; }
        bind "s" "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }

        // copy mode
        bind "[" { SwitchToMode "scroll"; }
    }
    scroll {
        bind "Esc" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "Down" "j" { ScrollDown; }
        bind "Up" "k" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "PageDown" "Ctrl f" { PageScrollDown; }
        bind "PageUp" "Ctrl b" { PageScrollUp; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
    }
    entersearch {
        bind "Enter" { SwitchToMode "search"; }
        bind "Esc" "Ctrl c" { SwitchToMode "scroll"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "Down" "j" { ScrollDown; }
        bind "Up" "k" { ScrollUp; }
        bind "Esc" "q" "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "locked"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "locked"; }
    }
}

// Plugin aliases (Zellij's defaults); "session-manager" above resolves through these
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    zellij:link
}

theme "onedark"
default_layout "compact"
default_mode "locked"
// plain ASCII status bar, no powerline arrow glyphs
simplified_ui true
