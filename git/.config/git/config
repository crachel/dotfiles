[user]
	name = Craig Rachel
	email = craig@craigrachel.com
[core]
	quotepath = false
[pull]
	ff = only
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
# delta pages diffs, log -p and show with syntax highlighting (Nord, matching bat); falls back to
# less/cat on machines without it. n/N jump between files.
[core]
	pager = "command -v delta >/dev/null && exec delta || exec less"
[interactive]
	diffFilter = "command -v delta >/dev/null && exec delta --color-only || exec cat"
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Nord
[merge]
	conflictStyle = zdiff3
