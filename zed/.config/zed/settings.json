//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "icon_theme": "Material Icon Theme",
    "show_wrap_guides": true,
    "wrap_guides": [80],
    "project_panel": {
        "default_width": 380.0,
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "agent": {
        "default_profile": "ask",
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "left",
    },
    "base_keymap": "Emacs",
    "ssh_connections": [
        {
            "host": "workstation",
            "username": "crachel",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/home/crachel/kelly-bushing"
                    ]
                },
                {
                    "paths": [
                        "/home/crachel/sql"
                    ]
                },
                {
                    "paths": [
                        "~/quickscout-api"
                    ]
                }
            ]
        }
    ],
    "tab_size": 4,
    "tabs": {
        "close_position": "right",
        "file_icons": false,
        "git_status": true,
        "activate_on_close": "history",
    },
    "languages": {
        "Python": {
            "tab_size": 4,
        },
    },
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "theme": {
        "mode": "dark",
        "light": "One Dark",
        "dark": "One Dark",
    },
}
